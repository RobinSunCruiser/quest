# QUEST Server Environment Configuration Template
#
# This file contains environment variables needed to configure the QUEST server.
# To use this file:
# 1. Copy this file to a new file named '.env' in the same directory
# 2. Add your actual configuration values (API keys, credentials, etc.)
# 3. Keep the .env file secure and never commit it to version control
#
# Example:
#   cp .env.example .env
#   nano .env  # Or use your preferred editor

#=============================================================================
# AUTHENTICATION & SECURITY
#=============================================================================

# JWT Secret - Used to sign and verify authentication tokens
# IMPORTANT: Set this in production to prevent user logouts on server restart
# Generate a secure secret using one of these commands:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   openssl rand -hex 64
# Tokens expire after 7 days
JWT_SECRET=your_jwt_secret_minimum_64_characters_recommended

#=============================================================================
# LLM PROVIDER API KEYS
#=============================================================================

# OpenAI API credentials - required for OpenAI models
# Get yours at: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API credentials - required for Claude models
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PerplexityAI API credentials - required for Perplexity models
# Get yours at: https://perplexity.ai/
PERPLEXITYAI_API_KEY=your_perplexityai_api_key_here

# Ollama API Keys (optional, for authenticated Ollama instances)
# Each Ollama adapter uses its own environment variable based on adapter ID
# For adapter "local" → LOCAL_API_KEY
# For adapter "gray" → GRAY_API_KEY
# For adapter "luebeck" → LUEBECK_API_KEY
# LOCAL_API_KEY=your_local_ollama_key_here
# GRAY_API_KEY=your_gray_ollama_key_here
# LUEBECK_API_KEY=your_luebeck_ollama_key_here

#=============================================================================
# SERVER CONFIGURATION
#=============================================================================

# Port the server will listen on
PORT=3000