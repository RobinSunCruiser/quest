# REMOVED — never commit private keys.
#
# Generate a self-signed TLS key/cert for local/dev use:
#   openssl req -x509 -newkey rsa:2048 -nodes -sha256 \
#     -keyout private.key -out certificate.crt \
#     -days 365 -subj "/CN=localhost"
#
# For production, obtain certificates from a real CA (e.g. Let's Encrypt).
