# QUEST Client Environment Configuration Template
#
# This is an example environment file for the QUEST client application.
# To use this file:
# 1. Copy this file to a new file named '.env' in the same directory
# 2. Modify the values as needed for your environment
# 3. The actual .env file should not be committed to version control
#
# Example:
#   cp .env.example .env
#   nano .env  # Or use your preferred editor

# Base URL for the QUEST backend server
# This variable configures where API requests will be sent
# - In development: typically points to localhost with the server port
# - In production: should point to your deployed API server URL
# - Must include protocol (http/https) and should not have a trailing slash
VITE_SERVER_BASE_URL=http://localhost:3000

# Note: All environment variables used in the Vite application must be
# prefixed with VITE_ to be accessible via import.meta.env in the code.
# Example usage in code: import.meta.env.VITE_SERVER_BASE_URL